# ===========================================
# Weekly Report Generator — Backend .env
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ===========================================

# --- PostgreSQL (Supabase) ---
# Get from: Supabase Dashboard → Settings → Database → Connection string (URI)
# Format: jdbc:postgresql://<host>:<port>/<database>
DB_URL=jdbc:postgresql://db.XXXXXX.supabase.co:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=your_database_password_here

# --- JWT Configuration ---
# Secret key for signing JWT tokens (must be at least 256 bits / 32 characters)
JWT_SECRET=WeeklyReportAppDefaultSecretKeyForJWTSigningMustBeAtLeast256BitsLong!!

# Token expiration in milliseconds (default: 86400000 = 24 hours)
JWT_EXPIRATION_MS=86400000
